# Host ports, change these if another project already uses them
API_HOST_PORT=3000
PG_HOST_PORT=5432

# Postgres
PG_HOST=postgres
PG_PORT=5432
PG_USER=appuser
PG_PASSWORD=apppass
PG_DATABASE=logistics

# Node API
NODE_PORT=3000
# Comma separated origins allowed to call the API, empty allows all (dev only)
CORS_ORIGINS=
JWT_SECRET=change_this_to_a_long_random_string

# Python service
PYTHON_PORT=8000

# Google Maps (web app). A browser key: it ends up in the JS bundle, so in
# Google Cloud restrict it by HTTP referrer (http://logistics-routing.test/*,
# http://localhost:5173/*, http://localhost:4173/*) and to the Maps
# JavaScript API and Places API (New). Empty turns maps off and the app
# falls back to typed addresses and coordinates.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers and dark mode. Empty uses DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# AI (Phase 2). An admin normally sets the Anthropic key and model on the
# Settings page; these are the fallback when nothing is saved there.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Encrypts secrets saved from the Settings page. 32 random bytes, base64:
#   openssl rand -base64 32
# Changing it makes saved secrets unreadable (re-enter them in Settings).
SETTINGS_ENCRYPTION_KEY=
# Where api-node reaches the internal AI service.
PYTHON_SERVICE_URL=http://service-python:8000
# Where service-python calls back into api-node for copilot tools.
API_NODE_URL=http://api-node:3000

# Route optimization (Phase 3). straight_line is the only provider for now;
# Phase 5 adds road distances. Solver search time in seconds.
DISTANCE_PROVIDER=straight_line
OPTIMIZER_TIME_LIMIT_S=5

# Customer SMS (Phase 4). Normally set by an admin on the Settings page;
# these are the fallback. SMS_PROVIDER is log (outbox only), termii or brevo.
SMS_PROVIDER=log
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
BREVO_API_KEY=
BREVO_SENDER=
# Address customers open from their SMS, and the name in the texts.
PUBLIC_APP_URL=http://logistics-routing.test
COMPANY_NAME=
